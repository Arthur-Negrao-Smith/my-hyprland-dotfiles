/* ---- Configuration ---- */
configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus";
    display-drun: "";
    display-run: "";
    display-window: "";
    drun-display-format: "{name}";
}

/* ---- Colors ---- */
* {
    bg0:    argb:E60f1823;
    bg1:    #0f1823;
    bg2:    argb:800f1823;
    bg3:    #584154;
    fg0:    #e5e7ea;
    fg1:    #c3c5c8;
    fg2:    #5e6774;
    fg3:    argb:A0c3c5c8;

    font:   "Roboto Medium 12";

    background-color:   transparent;
    text-color:         @fg0;
    margin:             0px;
    padding:            0px;
    spacing:            0px;
}

/* ---- Window ---- */
window {
    location:       center;
    anchor:         center;
    width:          500px;
    border-radius:  16px;
    border:         2px;
    border-color:   @bg3;
    
    background-color: @bg0;
}

mainbox {
    padding:    20px;
}

/* ---- Inputbar (Search) ---- */
inputbar {
    background-color:   @bg1;
    border-color:       @bg3;
    border:             2px;
    border-radius:      12px;
    padding:            12px 16px;
    spacing:            12px;
    children:           [ prompt, entry ];
}

prompt {
    text-color:         @fg0;
    font:               "Roboto 14";
    vertical-align:     0.5;
}

entry {
    text-color:         @fg0;
    placeholder:        "Pesquisar...";
    placeholder-color:  @fg2;
    vertical-align:     0.5;
    cursor:             text;
}

/* ---- Listview ---- */
listview {
    margin:         20px 0px 0px 0px;
    lines:          7;
    columns:        1;
    spacing:        6px;
    scrollbar:      false;
    dynamic:        true;
    fixed-height:   false;
}

/* ---- Elements ---- */
element {
    padding:          10px 16px;
    spacing:          16px;
    border-radius:    10px;
    cursor:           pointer;
    background-color: transparent;
}

element normal normal, element alternate normal {
    background-color: transparent; 
    text-color:       @fg0;
}

element normal active, element alternate active {
    background-color: transparent;
    text-color:       @bg3;
}

element selected normal, element selected active {
    background-color: @bg3;
    text-color:       #ffffff;
}

/* ---- Icons & Text ---- */
element-icon {
    size:             28px;
    background-color: transparent;
    cursor:           inherit;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    cursor:           inherit;
}

/* ---- Message / Error ---- */
message {
    margin:             12px 0 0;
    border-radius:      10px;
    border-color:       @bg2;
    background-color:   @bg2;
}

textbox {
    padding:            8px 24px;
    text-color:         @fg1;
}
